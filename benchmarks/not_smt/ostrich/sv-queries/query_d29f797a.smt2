(set-option :produce-models true)
(set-option :parse-transducers true)
(declare-const string0 String)
(declare-const out_str String)
(assert (not (= out_str string0)))
(assert (= out_str string0))
(define-fun-rec toUpper ((x String) (y String)) Bool (or (and (= x "") (= y "")) (and (not (= x "")) (not (= y "")) (= (char.code (str.head y)) (ite (and (<= 97 (char.code (str.head x))) (<= (char.code (str.head x)) 122)) (- (char.code (str.head x)) 32) (char.code (str.head x)))) (toUpper (str.tail x) (str.tail y)))))
(assert (toUpper string0 out_str))
(define-fun-rec toLower ((x String) (y String)) Bool (or (and (= x "") (= y ""))(and (not (= x "")) (not (= y ""))(= (char.code (str.head y))(ite (and (<= 65 (char.code (str.head x)))(<= (char.code (str.head x)) 90))(+ (char.code (str.head x)) 32)(char.code (str.head x))))(toLower (str.tail x) (str.tail y)))))
(assert (toLower string0 out_str))
(check-sat)
(get-model)