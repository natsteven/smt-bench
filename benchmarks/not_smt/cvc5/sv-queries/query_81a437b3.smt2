(set-option :produce-models true)
(declare-const string0 String)
(declare-const out_str String)
(declare-const nwc RegLan)
(declare-const ws RegLan)
(assert (not (= out_str "false")))
(assert (not (= out_str "no")))
(assert (not (= out_str "enabled")))
(assert (not (= out_str "1")))
(assert (not (= out_str "on")))
(assert (not (= out_str "true")))
(assert (not (= out_str "yes")))
(assert (and (str.in_re string0 (re.++ ws (str.to_re out_str) ws)) (or (= out_str "")(and (str.in_re out_str (re.++ nwc re.all)) (str.in_re out_str (re.++ re.all nwc))))))
(assert (= nwc (re.diff re.allchar (re.range (str.from_code 0) (str.from_code 32)))))
(assert (= (str.to_lower out_str) out_str))
(assert (= ws (re.union (re.+ (re.range (str.from_code 0) (str.from_code 32))) (str.to_re ""))))
(check-sat)
(get-model)